{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "code-review-harness/finding.schema.json",
  "title": "Findings contract (documentation; enforced by scripts/lib/findings.ts)",
  "$defs": {
    "RawFinding": {
      "type": "object",
      "required": [
        "dimension",
        "severity",
        "confidence",
        "file",
        "line",
        "title",
        "evidence",
        "impact",
        "recommendation",
        "effort"
      ],
      "properties": {
        "dimension": {
          "enum": [
            "architecture",
            "security",
            "quality",
            "performance",
            "testing",
            "dependencies",
            "operability",
            "data"
          ]
        },
        "severity": {
          "enum": [
            "Blocker",
            "Critical",
            "High",
            "Medium",
            "Low",
            "Nit"
          ]
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "file": {
          "type": "string",
          "description": "path relative to the source root; must exist"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        },
        "symbol": {
          "type": "string"
        },
        "snippet": {
          "type": "string",
          "description": "exact line, secrets masked"
        },
        "title": {
          "type": "string"
        },
        "evidence": {
          "type": "string"
        },
        "impact": {
          "type": "string"
        },
        "recommendation": {
          "type": "string"
        },
        "effort": {
          "enum": [
            "S",
            "M",
            "L",
            "XL"
          ]
        },
        "cwe": {
          "type": "string",
          "pattern": "^CWE-[0-9]+$",
          "description": "required for agent-reported security findings"
        },
        "category": {
          "type": "string"
        },
        "exploit_scenario": {
          "type": "string",
          "description": "required for agent-reported security findings"
        },
        "preconditions": {
          "type": "string"
        },
        "attack_surface": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "rule_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "RawShard": {
      "type": "object",
      "description": "raw/<stage>/<shard>.json, written by agents",
      "required": [
        "shard",
        "filesRead",
        "notReached",
        "findings"
      ],
      "properties": {
        "shard": {
          "type": "string"
        },
        "filesRead": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notReached": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RawFinding"
          }
        }
      }
    },
    "Vote": {
      "type": "object",
      "description": "votes/<id>--<lens>.json (file name must match)",
      "required": [
        "id",
        "lens",
        "verdict",
        "note"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z]{3}-[0-9a-f]{8,}$"
        },
        "lens": {
          "enum": [
            "REACHABILITY",
            "IMPACT",
            "DEFENSES",
            "VERIFY"
          ]
        },
        "verdict": {
          "enum": [
            "confirmed",
            "refuted",
            "needs-human"
          ]
        },
        "severity": {
          "enum": [
            "Blocker",
            "Critical",
            "High",
            "Medium",
            "Low",
            "Nit"
          ]
        },
        "note": {
          "type": "string"
        },
        "evidence": {
          "type": "string"
        }
      }
    },
    "Decision": {
      "type": "object",
      "description": "consolidate/<group>.json",
      "required": [
        "group",
        "merges"
      ],
      "properties": {
        "group": {
          "type": "string",
          "pattern": "^G-[0-9a-f]{10}$"
        },
        "merges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "keep",
              "merge",
              "reason"
            ],
            "properties": {
              "keep": {
                "type": "string"
              },
              "merge": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "reason": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "Finding": {
      "description": "findings.json entries \u2014 script-owned",
      "allOf": [
        {
          "$ref": "#/$defs/RawFinding"
        }
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z]{3}-[0-9a-f]{8,}$"
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^v1:[0-9a-f]{64}$"
        },
        "category": {
          "type": "string"
        },
        "reporters": {
          "type": "integer"
        },
        "shards": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "verdict": {
          "enum": [
            "confirmed",
            "refuted",
            "needs-human",
            "deferred"
          ]
        },
        "votes": {
          "type": "array"
        },
        "verifier_note": {
          "type": "string"
        },
        "original_severity": {
          "type": "string"
        },
        "accepted": {
          "type": "object"
        },
        "also_reported_as": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "consolidation_note": {
          "type": "string"
        }
      }
    }
  },
  "$ref": "#/$defs/RawShard"
}
